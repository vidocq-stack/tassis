<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.tassis</groupId>
        <artifactId>tassis-parent</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>tassis-coverage</artifactId>
    <packaging>pom</packaging>

    <name>Tassis Coverage</name>
    <description>Aggregated JaCoCo report of the reactor, read by SonarQube (quality profile only)</description>

    <properties>
        <!-- Quality-only module, listed by the quality profile of tassis-parent: never released,
             installed or deployed. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.install.skip>true</maven.install.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <maven.source.skip>true</maven.source.skip>
        <gpg.skip>true</gpg.skip>
    </properties>

    <!--
        report-aggregate reads these dependencies: in compile scope, their classes, sources and
        execution data make up the report; in test scope, only their execution data counts.
        tassis-cdi-vauban-module-it is a test vehicle whose tests exercise the other modules on
        the module path, so without this report they would not count for the code they exercise
        (Vidocq/vidocq#284). tassis-api only re-exposes the specification API, tassis-examples
        stays out of the coverage, and tassis-tck, tassis-interop and tassis-bench only join the
        reactor under their own profiles, which the quality build does not activate.
    -->
    <dependencies>
        <dependency>
            <groupId>io.vidocq.tassis</groupId>
            <artifactId>tassis-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.tassis</groupId>
            <artifactId>tassis-amqp</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.tassis</groupId>
            <artifactId>tassis-server</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.tassis</groupId>
            <artifactId>tassis-pool</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.tassis</groupId>
            <artifactId>tassis-cdi-vauban</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.tassis</groupId>
            <artifactId>tassis-cdi-vauban-module-it</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>report-aggregate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                        <configuration>
                            <formats>
                                <format>XML</format>
                            </formats>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
