<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.tassis</groupId>
        <artifactId>tassis-parent</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>tassis-pool</artifactId>
    <name>Tassis :: Pool</name>
    <description>A connection factory that keeps the connections to the broker and lends them, see ROADMAP M11b</description>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.tassis</groupId>
            <artifactId>tassis-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The pool over a socket: the network transport and a server, for the tests only. -->
        <dependency>
            <groupId>io.vidocq.tassis</groupId>
            <artifactId>tassis-amqp</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.tassis</groupId>
            <artifactId>tassis-server</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <!-- A test reads what the pool logs with the JDK's own logging, which
                                 the module of the pool has no reason to require. -->
                            <compilerArgs>
                                <arg>--add-modules</arg>
                                <arg>java.logging</arg>
                                <arg>--add-reads</arg>
                                <arg>io.vidocq.tassis.pool=java.logging</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- The module of the pool requires neither the transport nor the server, so on
                         the module path the tests could not reach them: they run on the class path.
                         The pool on the module path is proven by tassis-examples. -->
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
