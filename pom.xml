<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         >
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq</groupId>
        <artifactId>vidocq-parent</artifactId>
        <version>0.4.0-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <groupId>io.vidocq.tassis</groupId>
    <artifactId>tassis-parent</artifactId>
    <version>0.4.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Tassis</name>
    <description>Jakarta Messaging 3.1 provider: zero third-party dependency, in-VM broker, virtual threads, strict Java Modules</description>
    <url>https://codefloe.com/Vidocq/tassis</url>

    <developers>
        <developer>
            <name>Yann Blazart</name>
            <email>yann.blazart@gmail.com</email>
        </developer>
    </developers>

    <!--
        Disjunctive triple license: a recipient may use this software under
        ANY ONE of the three licences below, at their option. EPL-2.0 is the
        anchor (see the LICENSE file); per EPL-2.0 section 1, GPL-2.0-or-later
        is offered as a Secondary License.
        SPDX-License-Identifier: EPL-2.0 OR EUPL-1.2 OR GPL-2.0-or-later
    -->
    <licenses>
        <license>
            <name>EPL-2.0</name>
            <url>https://www.eclipse.org/legal/epl-2.0/</url>
            <distribution>repo</distribution>
        </license>
        <license>
            <name>EUPL-1.2</name>
            <url>https://joinup.ec.europa.eu/collection/eupl/eupl-text-eupl-12</url>
            <distribution>repo</distribution>
        </license>
        <license>
            <name>GPL-2.0-or-later</name>
            <url>https://www.gnu.org/licenses/old-licenses/gpl-2.0.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <url>https://codefloe.com/Vidocq/tassis</url>
        <connection>scm:git:https://codefloe.com/Vidocq/tassis.git</connection>
        <developerConnection>scm:git:git@codefloe.com:Vidocq/tassis.git</developerConnection>
    </scm>

    <properties>
        <!-- Jakarta Messaging 3.1 spec API: already modular upstream (module jakarta.messaging,
             package jakarta.jms), no Vidocq fork needed. -->
        <jakarta.jms.version>3.1.0</jakarta.jms.version>

        <!-- CDI integration (tassis-cdi-vauban) -->
        <jakarta.cdi.version>4.1.0</jakarta.cdi.version>
        <jakarta.inject.version>2.0.1</jakarta.inject.version>
        <jakarta.annotation.version>3.0.0</jakarta.annotation.version>
        <!-- Vidocq upstream, by property so that a cross-repo PR can override it -->
        <vauban.version>0.4.0-SNAPSHOT</vauban.version>

        <!--
            SonarQube (Vidocq/vidocq#284): every module reads the aggregated JaCoCo report of
            tassis-coverage (quality profile), so the tests of tassis-cdi-vauban-module-it count
            for the code they exercise in the other modules. tassis-examples stays analysed
            (people copy examples) but out of the coverage, and may print to System.out (rule
            java:S106).
        -->
        <sonar.coverage.jacoco.xmlReportPaths>${maven.multiModuleProjectDirectory}/tassis-coverage/target/site/jacoco-aggregate/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
        <sonar.coverage.exclusions>**/tassis-examples/**</sonar.coverage.exclusions>
        <sonar.issue.ignore.multicriteria>examples</sonar.issue.ignore.multicriteria>
        <sonar.issue.ignore.multicriteria.examples.ruleKey>java:S106</sonar.issue.ignore.multicriteria.examples.ruleKey>
        <sonar.issue.ignore.multicriteria.examples.resourceKey>**/tassis-examples/**/src/main/java/**</sonar.issue.ignore.multicriteria.examples.resourceKey>
    </properties>

    <!--
        Main reactor modules. tassis-tck joins the reactor only under the `tck`
        Maven profile (see <profiles> below), same pattern as every other
        sub-project of this workspace: a regular `mvn install` neither builds
        nor downloads the TCK harness. Activation: ./mvnw -Ptck -pl tassis-tck test
    -->
    <modules>
        <module>tassis-api</module>
        <module>tassis-core</module>
        <module>tassis-amqp</module>
        <module>tassis-server</module>
        <module>tassis-pool</module>
        <module>tassis-cdi-vauban</module>
        <module>tassis-cdi-vauban-module-it</module>
        <module>tassis-examples</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Jakarta Messaging 3.1 -->
            <dependency>
                <groupId>jakarta.jms</groupId>
                <artifactId>jakarta.jms-api</artifactId>
                <version>${jakarta.jms.version}</version>
            </dependency>

            <!-- CDI -->
            <dependency>
                <groupId>jakarta.enterprise</groupId>
                <artifactId>jakarta.enterprise.cdi-api</artifactId>
                <version>${jakarta.cdi.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.inject</groupId>
                <artifactId>jakarta.inject-api</artifactId>
                <version>${jakarta.inject.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.annotation</groupId>
                <artifactId>jakarta.annotation-api</artifactId>
                <version>${jakarta.annotation.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.vauban</groupId>
                <artifactId>vauban-api</artifactId>
                <version>${vauban.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.vauban</groupId>
                <artifactId>vauban-core</artifactId>
                <version>${vauban.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.vauban</groupId>
                <artifactId>vauban-classloader-spi</artifactId>
                <version>${vauban.version}</version>
            </dependency>

            <!-- Internal Tassis modules -->
            <dependency>
                <groupId>io.vidocq.tassis</groupId>
                <artifactId>tassis-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.tassis</groupId>
                <artifactId>tassis-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.tassis</groupId>
                <artifactId>tassis-amqp</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.tassis</groupId>
                <artifactId>tassis-server</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.tassis</groupId>
                <artifactId>tassis-pool</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.tassis</groupId>
                <artifactId>tassis-cdi-vauban</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <profiles>
        <!--
            The official Jakarta Messaging TCK runner joins the reactor only
            when this profile is active:

                ./mvnw -Ptck -pl tassis-tck test
        -->
        <profile>
            <id>tck</id>
            <modules>
                <module>tassis-tck</module>
            </modules>
        </profile>
        <!--
            The interoperability tests, the one module that depends on third-party code (in
            test scope, and never published), join the reactor only when this profile is active:

                ./mvnw -Pinterop -pl tassis-interop -am verify
        -->
        <profile>
            <id>interop</id>
            <modules>
                <module>tassis-interop</module>
            </modules>
        </profile>
        <!--
            The benchmarks depend on third-party code too (JMH, and the brokers and the client
            Tassis is compared with), are never published, and join the reactor only when this
            profile is active:

                ./mvnw -Pbench -pl tassis-bench -am verify
                java -jar tassis-bench/target/benchmarks.jar
        -->
        <profile>
            <id>bench</id>
            <modules>
                <module>tassis-bench</module>
            </modules>
        </profile>
        <!--
            Quality profile (with the one of vidocq-parent, which runs the JaCoCo agent): adds
            the aggregated coverage report that SonarQube reads (Vidocq/vidocq#284).
        -->
        <profile>
            <id>quality</id>
            <modules>
                <module>tassis-coverage</module>
            </modules>
        </profile>
    </profiles>
</project>
