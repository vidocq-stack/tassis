<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.tassis</groupId>
        <artifactId>tassis-parent</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>tassis-cdi-vauban</artifactId>
    <name>Tassis :: CDI (Vauban)</name>
    <description>CDI integration: JMSContext injection (@JMSConnectionFactory, @JMSSessionMode, @JMSPasswordCredential), see ROADMAP M9 (placeholder for now)</description>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.tassis</groupId>
            <artifactId>tassis-core</artifactId>
        </dependency>
        <!-- The factories built from the settings pool their connections to a broker of the network. -->
        <dependency>
            <groupId>io.vidocq.tassis</groupId>
            <artifactId>tassis-pool</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Compile-only, like the CDI API: the service type of the generated component provider. -->
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-classloader-spi</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!--
                        Vauban's code generation runs as an annotation processor on this module's
                        beans: client proxy, factories and one _VaubanComponents provider per
                        package, so that the container instantiates, injects and invokes them
                        without reflection. Build-time only.
                    -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>io.vidocq.vauban</groupId>
                            <artifactId>vauban-processor</artifactId>
                            <version>${vauban.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
                <executions>
                    <!-- The test fixtures are not application beans to generate code for. -->
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <proc>none</proc>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                        Test-only. The tests build a VaubanContainer (vauban-core, which this
                        module does not read) over application beans of the test package `app`,
                        which have no generated code: Vauban reaches those reflectively. The
                        package of the integration's own beans is NOT opened: they are wired by
                        the generated _VaubanComponents.
                    -->
                    <!-- @{argLine} keeps the JaCoCo agent of the quality profile (vidocq-parent). -->
                    <argLine>
                        @{argLine}
                        --add-reads io.vidocq.tassis.cdi.vauban=io.vidocq.vauban.core
                        --add-opens io.vidocq.tassis.cdi.vauban/io.vidocq.tassis.cdi.app=io.vidocq.vauban.core
                    </argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
